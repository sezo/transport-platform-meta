{
  "realm": "transport",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "roles": {
    "realm": [
      { "name": "Passenger", "description": "B2C passenger" },
      { "name": "BusinessClient", "description": "B2B client" },
      { "name": "Inspector", "description": "Ticket inspector — VPN access" },
      { "name": "Driver", "description": "Vehicle driver — VPN access" },
      { "name": "FleetManager", "description": "Fleet management — VPN access" },
      { "name": "OnboardDevice", "description": "Onboard CPU service account" },
      { "name": "SmartCardDevice", "description": "Smart card reader service account" },
      { "name": "Admin", "description": "Backoffice administrator" },
      { "name": "Accountant", "description": "Accounting staff" }
    ]
  },
  "clients": [
    {
      "clientId": "public-gateway",
      "name": "YARP Public Gateway",
      "enabled": true,
      "serviceAccountsEnabled": true,
      "description": "M2M client for public gateway → service calls"
    },
    {
      "clientId": "internal-gateway",
      "name": "YARP Internal Gateway",
      "enabled": true,
      "serviceAccountsEnabled": true,
      "description": "M2M client for internal gateway → service calls (VPN only)"
    },
    {
      "clientId": "transport-ticketing",
      "name": "Ticketing Service",
      "enabled": true,
      "serviceAccountsEnabled": true,
      "description": "M2M client for ticketing service → service calls"
    },
    {
      "clientId": "transport-vehicles",
      "name": "Vehicle Service",
      "enabled": true,
      "serviceAccountsEnabled": true,
      "description": "M2M client for vehicle service → service calls"
    },
    {
      "clientId": "transport-accounting",
      "name": "Accounting Service",
      "enabled": true,
      "serviceAccountsEnabled": true,
      "description": "M2M client for accounting service → service calls"
    },
    {
      "clientId": "transport-reporting",
      "name": "Reporting Service",
      "enabled": true,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "b2c-web",
      "name": "B2C Web Portal",
      "enabled": true,
      "publicClient": true,
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200"]
    },
    {
      "clientId": "b2b-web",
      "name": "B2B Web Portal",
      "enabled": true,
      "publicClient": true,
      "redirectUris": ["http://localhost:4201/*"],
      "webOrigins": ["http://localhost:4201"]
    },
    {
      "clientId": "admin-web",
      "name": "Admin Portal",
      "enabled": true,
      "publicClient": true,
      "redirectUris": ["http://localhost:4202/*"],
      "webOrigins": ["http://localhost:4202"]
    },
    {
      "clientId": "mobile-app",
      "name": "Mobile App (Flutter)",
      "enabled": true,
      "publicClient": true,
      "redirectUris": ["transportplatform://auth/callback"]
    }
  ]
}
